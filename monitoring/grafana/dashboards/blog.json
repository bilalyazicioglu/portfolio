          "refId": "A"
        },
        {
          "expr": "max by(instance, mountpoint) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\", mountpoint=\"/\"}) > 0",
          "legendFormat": "avail {{mountpoint}}",
          "refId": "B"
